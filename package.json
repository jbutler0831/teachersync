{
  "name": "teachersync",
  "productName": "TeacherSync",
  "version": "0.1.1",
  "description": "Plan classes, lessons, assignments, grading and daily tasks in one place. A desktop app for Mac and Windows, and an installable web app for phones and computers.",
  "author": "Jorel Butler",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "icons": "node scripts/make-icons.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "vitest run && vite build",
    "desktop": "vite build && electron .",
    "dist:mac": "node scripts/make-icons.js && vite build && electron-builder --mac",
    "dist:win": "node scripts/make-icons.js && vite build && electron-builder --win",
    "dist": "node scripts/make-icons.js && vite build && electron-builder --mac --win"
  },
  "devDependencies": {
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/public-sans": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "jsdom": "30.1.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "build": {
    "appId": "com.teachersync.desktop",
    "productName": "TeacherSync",
    "copyright": "Copyright © 2026 Jorel Butler",
    "files": [
      "dist/**/*",
      "desktop/main.cjs",
      "desktop/lib.cjs",
      "package.json",
      "LICENSE"
    ],
    "directories": {
      "buildResources": "desktop",
      "output": "release"
    },
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false,
      "enableCookieEncryption": false,
      "enableEmbeddedAsarIntegrityValidation": false,
      "loadBrowserProcessSpecificV8Snapshot": false,
      "resetAdHocDarwinSignature": true
    },
    "mac": {
      "category": "public.app-category.education",
      "icon": "desktop/icon.png",
      "identity": "-",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "dmg": {
      "title": "TeacherSync ${version}",
      "artifactName": "TeacherSync-${version}-mac-${arch}.${ext}"
    },
    "win": {
      "icon": "desktop/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "TeacherSync",
      "artifactName": "TeacherSync-Setup-${version}.${ext}"
    }
  }
}
